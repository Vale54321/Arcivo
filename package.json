{
  "name": "@arcivo/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "nx run-many -t serve --parallel=3 --outputStyle=stream",
    "build": "nx run-many -t build --outputStyle=stream",
    "lint": "nx run-many -t lint --outputStyle=stream",
    "lint:fix": "nx run-many -t lint:fix --outputStyle=stream",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "nx run-many -t test --outputStyle=stream",
    "deploy:website": "npm run deploy --workspace @arcivo/website",
    "deploy:ui-playbook": "npm run deploy --workspace @arcivo/ui-components"
  },
  "devDependencies": {
    "@nx/js": "23.1.1",
    "@nx/workspace": "23.1.1",
    "nx": "23.1.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "wrangler": "^4.125.0"
  }
}
