{
  "watch": [
    "src",
    "../../libs/api-contracts/src",
    "../../libs/ui-components/src"
  ],
  "ext": "ts,json",
  "ignore": [
    "src/**/*.spec.ts"
  ],
  "exec": "ts-node -r tsconfig-paths/register src/main.ts",
  "delay": 1000,
  "signal": "SIGTERM",
  "env": {
    "TS_NODE_PROJECT": "tsconfig.dev.json"
  }
}