{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"serve": "vite dev --host",
		"dev": "npm run serve",
		"build": "npm run check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "oxfmt --check . && oxlint",
		"lint:fix": "oxfmt --write . && oxlint --fix",
		"format": "oxfmt --write ."
	},
	"dependencies": {
		"@arcivo/api-contracts": "file:../../libs/api-contracts",
		"@lucide/svelte": "^1.3.0",
		"@types/crypto-js": "^4.2.2",
		"crypto-js": "^4.2.0",
		"pdfjs-dist": "^6.2.108"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"vitest": "^4.0.18"
	},
	"engines": {
		"node": ">=24 <25"
	}
}
