{
  "name": "@arcivo/ui-components",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "serve": "vite --config playground/vite.config.ts --host 0.0.0.0 --port 6006",
    "playground:build": "vite build --config playground/vite.config.ts",
    "dev:worker": "npm run playground:build && wrangler dev",
    "deploy": "npm run playground:build && wrangler deploy",
    "test": "npm run check"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
