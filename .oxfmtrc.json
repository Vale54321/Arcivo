{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": ["apps/frontend/**"],
      "options": {
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none",
        "printWidth": 100,
        "svelte": true,
        "sortTailwindcss": {
          "stylesheet": "apps/frontend/src/routes/layout.css"
        }
      }
    }
  ]
}
