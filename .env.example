# PostgreSQL password used by the local database and backend.
DB_PASSWORD=arcivo

# Use a unique value of at least 32 characters outside local development.
JWT_SECRET=change-this-local-development-jwt-secret-please

# Set to true only for local development. The frontend will automatically sign
# in as the seeded admin@example.com user. This is always disabled in production.
DEV_AUTO_AUTH_DEFAULT_ADMIN=false
